# Copy this file to `.env` and set POSTGRES_PASSWORD before running.
# `.env` is gitignored; this example is not.

API_BASE=http://localhost
PUBLIC_SITE_URL=http://localhost:5173

# Origins allowed to open the WebSocket and make state-changing API calls
# (comma-separated). This is the CSRF / cross-site-WebSocket-hijacking allowlist:
# a browser request whose Origin is not listed here is rejected. Includes both
# local stacks by default; in production set it to your real site origin, e.g.
# https://yourapp.com. If left empty the check fails OPEN in development (a
# fresh checkout still runs) but CLOSED in production (browser requests and
# WebSocket upgrades are refused, loudly) — see backend/src/security/origin.ts.
# PUBLIC_SITE_URL doubles as the allowlist when this is unset.
#
# The 127.0.0.1 entries are NOT redundant with the localhost ones. An Origin is
# matched as a STRING, so http://127.0.0.1:8080 and http://localhost:8080 are
# different origins even though they reach the same server. On a Windows host
# `localhost` can resolve to IPv6 ::1 where the published port refuses (§9), which
# leaves 127.0.0.1 as the only address a browser can actually load the app from —
# and without it listed, the page renders but every WebSocket upgrade is rejected
# and the UI just says "Offline".
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# --- Development stack (docker-compose.yaml) ---
FRONTEND_HOST=frontend-c
FRONTEND_PORT=5173

BACKEND_HOST=server-c
BACKEND_PORT=3000

# --- Production and development stack (docker-compose.prod.yaml) ---
# Put your postgres info here
POSTGRES_HOST=postgres-c
POSTGRES_PORT=5432
POSTGRES_USER=postgre
POSTGRES_PASSWORD=
POSTGRES_DB=info_db

# --- Production stack (docker-compose.prod.yaml) ---
# The only host port the production stack publishes. nginx serves the built
# frontend here and proxies /api + /ws to the backend over the internal network.
PROD_PORT=8080

# --- Single-container PaaS deploys (Dockerfile.render / render.yaml) ---
# NOT used by either compose stack — leave these unset locally. They exist for
# free-tier hosts that run exactly one container (Render + Neon):
#
#   STATIC_DIR              - path to the built frontend; when set, the backend
#                             serves it and plays nginx's role (staticSite.ts).
#                             Dockerfile.render bakes this in.
#   PGSSLMODE               - set to `require` when the database is a TLS-only
#                             host like Neon. Read by node-postgres directly.
#   TRUSTED_CLIENT_IP_HEADER- which request header carries the real client IP
#                             for rate limits / socket caps. Defaults to
#                             x-real-ip (our nginx). On Render set it to
#                             true-client-ip. Only ever name a header the
#                             platform overwrites on every request — see
#                             backend/src/security/clientIp.ts.

# Protects GET /api/metrics (Prometheus scrape target — connection counts,
# latency histograms, error rates; reconnaissance if public). Send it as
# `Authorization: Bearer <token>`, or as the password half of Basic auth (what
# Grafana Cloud's scraper sends; the username is ignored). Unset: open in
# development, 404 in production — same fail-closed posture as the origin
# allowlist. Generate one the same way as the secrets below.
METRICS_TOKEN=

# Email-at-rest secrets. BOTH must be set in production or the server refuses to
# start (see backend/src/auth/emailCrypto.ts). In development, insecure built-in
# defaults are used with a loud warning so a fresh clone still runs.
#
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# They are deliberately SEPARATE secrets: the pepper never decrypts anything and
# the key never helps you search, so leaking one does not give both capabilities.
EMAIL_INDEX_PEPPER=<generate me>
EMAIL_ENCRYPTION_KEY=<generate me>

# --- Outgoing email (verification + password reset) ---
# The backend sends two emails: an address-verification link and a
# password-reset link. Both point at PUBLIC_SITE_URL (set at the top of this
# file), never at a request Host header, so they cannot be poisoned to point at
# an attacker's domain.
#
# These are OPTIONAL. Email verification and password reset are enhancements —
# nothing in the app requires a verified address (accounts and drawing work
# without them) — so leaving these blank is fine in BOTH development and
# production. With no SMTP configured the server still boots; it just logs the
# verification/reset links to its own console instead of sending them (look for
# "[mailer] SMTP not configured ..." in `docker compose logs backend`), which is
# also enough to click through the whole flow locally without a mail server.
#
# Set them to actually deliver mail. Point these at any SMTP provider (e.g. a
# transactional-email service):
#
#   SMTP_HOST      - the SMTP server hostname
#   SMTP_PORT      - 587 for STARTTLS (default), or 465 with SMTP_SECURE=true
#   SMTP_SECURE    - "true" for implicit TLS (port 465); otherwise leave unset
#   SMTP_USER      - SMTP username (leave blank for an unauthenticated relay)
#   SMTP_PASSWORD  - SMTP password
#   EMAIL_FROM     - the From address, e.g. "Online Whiteboard <no-reply@yourapp.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
